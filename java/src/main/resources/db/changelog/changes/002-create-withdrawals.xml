<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
                   logicalFilePath="db/changelog/changes/002-create-withdrawals.yaml">

    <changeSet id="002-create-withdrawals" author="time-deposit">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <tableExists tableName="withdrawals"/>
            </not>
        </preConditions>
        <createTable tableName="withdrawals">
            <column name="id" type="INTEGER" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_withdrawals" nullable="false"/>
            </column>
            <column name="timeDepositId" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="date" type="DATE">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_withdrawals_time_deposit"
                                 baseTableName="withdrawals" baseColumnNames="timeDepositId"
                                 referencedTableName="timeDeposits" referencedColumnNames="id"
                                 onDelete="RESTRICT"/>
        <createIndex tableName="withdrawals" indexName="idx_withdrawals_time_deposit">
            <column name="timeDepositId"/>
        </createIndex>
        <rollback>
            <dropTable tableName="withdrawals"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
